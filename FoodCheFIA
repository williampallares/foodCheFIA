<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FoodSaverIA</title>

<style>
body{margin:0;font-family:Arial, sans-serif;background:#f4f6f8;transition:0.3s;}

.header{
  display:flex;
  justify-content:space-between;
  align-items: center;
  padding:15px;
  background:red;
  color:white;
  font-weight: bold;
}

.header button {
  width: auto !important;
  margin: 0 !important;
  padding: 5px 10px !important;
}

.chat{
  height:52vh;
  overflow-y:auto;
  padding:10px;
  background:white;
  border-bottom: 1px solid #ccc;
}

.msg{margin:6px;padding:12px;border-radius:12px;white-space: pre-wrap; max-width: 85%;}
.user{background:red;color:white;text-align:right; margin-left: auto;}
.ia{background:#e0e0e0; color: black; margin-right: auto;}

.banner-promo {
  background: linear-gradient(135deg, #fff3cd, #ffe8a1);
  border: 1px solid #ffeba8;
  padding: 10px 15px;
  margin: 8px 10px 0 10px;
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: #856404;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}
.banner-promo button {
  background: #ff4747;
  color: white;
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
}

#input, #btnEnviar {
  width:100%;
  padding:12px;
  margin-top:10px;
  box-sizing: border-box;
}

.menu{
  display:none;
  position:fixed;
  top:60px;
  left:5%;
  width:90%;
  background:white;
  padding:15px;
  box-shadow: 0px 4px 10px rgba(0,0,0,0.2);
  z-index: 100;
  border-radius: 8px;
}

.menu button {
  width: 100%;
  padding: 12px;
  margin-top: 8px;
  box-sizing: border-box;
  background: #ff4747;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
}

#loginModal {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}
.modal-content {
  background: white;
  padding: 25px;
  border-radius: 12px;
  width: 85%;
  max-width: 350px;
  text-align: center;
}
.modal-content input {
  width: 100%;
  padding: 12px;
  margin-top: 15px;
  margin-bottom: 10px;
  box-sizing: border-box;
  border: 1px solid #ccc;
  border-radius: 6px;
}
.modal-content button {
  width: 100%;
  padding: 12px;
  background: red;
  color: white;
  border: none;
  border-radius: 6px;
  font-weight: bold;
}
</style>
</head>

<body onload="iniciarSesion()">

<div id="loginModal">
  <div class="modal-content">
    <h2 style="margin:0; color:red;">🍳 FoodSaverIA</h2>
    <p style="margin:5px 0 0 0; color:#555;">¡Ingresá tu nombre para empezar!</p>
    <input id="nombreUser" placeholder="Tu nombre" onkeydown="evaluarEnterLogin(event)">
    <button onclick="guardarPerfil()">Entrar a FoodSaverIA</button>
  </div>
</div>

<div class="header">
<span>🍳 FoodSaverIA</span>
<button onclick="toggleMenu()">⚙️</button>
</div>

<div id="menu" class="menu">

🔊 Voz <input type="checkbox" id="voz"><br><br>

🎚 Tono
<input type="range" id="tono" min="0.5" max="2" step="0.1" value="1"><br><br>

🌗 Brillo
<input type="range" id="pantalla" min="0" max="100" value="50"><br><br>

<h3>⭐ FoodSaverIA Premium</h3>
<div id="opcionesCompra">
  <button onclick="comprar(1)">1 mes - $5</button>
  <button onclick="comprar(2)">2 meses - $9</button>
  <button onclick="comprar(5)">5 meses - $20</button>
</div>

<p id="estadoPremium">❌ Cuenta Gratuita</p>
<button id="btnDesuscribir" onclick="desuscribirse()" style="display:none; background: #ff4d4d; color: white;">Cancelar Suscripción</button>

<br><br>
<button id="btnCambiarCuenta" onclick="cambiarPerfil()" style="background: #6c757d;">👤 Cambiar de Cuenta</button>

</div>

<div id="chat" class="chat"></div>

<div id="bannerAnuncio" class="banner-promo">
  <span id="textoAnuncio">✨ <b>¡Desbloqueá el recetario Michelin completo con tips!</b></span>
  <button onclick="toggleMenu()">Ver Planes</button>
</div>

<input id="input" placeholder="Pedí un plato o escribí ingredientes..." onkeydown="evaluarEnterChat(event)">
<button id="btnEnviar" onclick="enviar()">Buscar en FoodSaverIA</button>

<script>
const chat = document.getElementById("chat");
const voz = document.getElementById("voz");
const tono = document.getElementById("tono");
const pantalla = document.getElementById("pantalla");

let perfil = null;
let esperando = false;
let ultimaReceta = "";

function evaluarEnterLogin(e) { if (e.key === "Enter") guardarPerfil(); }
function evaluarEnterChat(e) { if (e.key === "Enter") enviar(); }

function iniciarSesion(){
  let data = localStorage.getItem("perfil");
  if(data){
    perfil = JSON.parse(data);
    document.getElementById("loginModal").style.display="none";
    if(perfil.esPremium === undefined || !perfil.fechaVencimiento) {
      perfil.esPremium = false;
      perfil.fechaVencimiento = null;
      localStorage.setItem("perfil", JSON.stringify(perfil));
    }
    verificarVencimiento();
    actualizarInterfazPremium();
    chat.innerHTML = ""; 
    add("🍳 ¡Hola " + perfil.nombre + "! Bienvenido a FoodSaverIA. Escribí los ingredientes que tenés o el plato que querés preparar.", "ia");
  } else {
    document.getElementById("loginModal").style.display="flex";
  }
}

function guardarPerfil(){
  let nombre = document.getElementById("nombreUser").value.trim();
  if(!nombre) return alert("Poné tu nombre");
  perfil = { nombre: nombre, esPremium: false, fechaVencimiento: null };
  localStorage.setItem("perfil", JSON.stringify(perfil));
  iniciarSesion();
}

function cambiarPerfil(){
  let nuevo = prompt("Nombre del nuevo usuario:");
  if(nuevo && nuevo.trim() !== ""){
    perfil = { nombre: nuevo.trim(), esPremium: false, fechaVencimiento: null };
    localStorage.setItem("perfil", JSON.stringify(perfil));
    iniciarSesion();
    toggleMenu();
  }
}

function verificarVencimiento(){
  if(perfil && perfil.esPremium && perfil.fechaVencimiento){
    if(new Date().getTime() > perfil.fechaVencimiento){
      perfil.esPremium = false;
      perfil.fechaVencimiento = null;
      localStorage.setItem("perfil", JSON.stringify(perfil));
      alert("⏰ Tu plan Premium ha vencido.");
    }
  }
}

function actualizarInterfazPremium() {
  const estado = document.getElementById("estadoPremium");
  const opciones = document.getElementById("opcionesCompra");
  const btnDesuscribir = document.getElementById("btnDesuscribir");
  const bannerAnuncio = document.getElementById("bannerAnuncio");

  if(perfil && perfil.esPremium && perfil.fechaVencimiento){
    let fechaStr = new Date(perfil.fechaVencimiento).toLocaleDateString();
    estado.innerText = "✅ FoodSaverIA Premium Activo (Vence: " + fechaStr + ")";
    opciones.style.display = "none";
    btnDesuscribir.style.display = "block";
    bannerAnuncio.style.display = "none"; 
  } else {
    estado.innerText = "❌ FoodSaverIA Gratuito (Limitado)";
    opciones.style.display = "block";
    btnDesuscribir.style.display = "none";
    bannerAnuncio.style.display = "flex"; 
  }
}

function comprar(meses){
  if(!perfil) return;
  let fechaActual = new Date();
  fechaActual.setMonth(fechaActual.getMonth() + meses);
  perfil.esPremium = true;
  perfil.fechaVencimiento = fechaActual.getTime();
  localStorage.setItem("perfil", JSON.stringify(perfil));
  actualizarInterfazPremium();
  add("⭐ ¡Activaste FoodSaverIA Premium!", "ia");
}

function desuscribirse(){
  if(!perfil) return;
  perfil.esPremium = false;
  perfil.fechaVencimiento = null;
  localStorage.setItem("perfil", JSON.stringify(perfil));
  actualizarInterfazPremium();
  add("🛑 Volviste al plan gratuito de FoodSaverIA.", "ia");
}

function escribirEfecto(elemento, texto) {
  let i = 0;
  elemento.innerText = ""; 
  function tipeado() {
    if (i < texto.length) {
      elemento.innerText += texto.charAt(i);
      i++;
      chat.scrollTop = chat.scrollHeight; 
      setTimeout(tipeado, 12); 
    } else {
      mostrarBotonGuardar();
      hablar(texto);
      esperando = false; 
    }
  }
  tipeado();
}

function copiarTextoUniversal(texto) {
  if (navigator.clipboard && window.isSecureContext) {
    return navigator.clipboard.writeText(texto);
  } else {
    return new Promise((resolve, reject) => {
      let textArea = document.createElement("textarea");
      textArea.value = texto;
      textArea.style.position = "fixed";
      textArea.style.left = "-999999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        let exito = document.execCommand('copy');
        document.body.removeChild(textArea);
        exito ? resolve() : reject();
      } catch (err) {
        document.body.removeChild(textArea);
        reject(err);
      }
    });
  }
}

function mostrarBotonGuardar(){
  const btnExistente = document.getElementById("btnCopiarReceta");
  if(btnExistente) btnExistente.remove();

  let btn = document.createElement("button");
  btn.id = "btnCopiarReceta";
  btn.innerText = "📋 Copiar Ficha de FoodSaverIA";
  btn.style.background = "#4CAF50";
  btn.style.color = "white";

  btn.onclick = () => {
    if(!perfil || !perfil.esPremium) {
      alert("🔒 Función exclusiva para usuarios FoodSaverIA Premium ⭐.");
      return;
    }
    copiarTextoUniversal(ultimaReceta)
      .then(() => alert("✅ ¡Receta copiada!"))
      .catch(() => alert("❌ No se pudo copiar."));
  };

  chat.appendChild(btn);
  chat.scrollTop = chat.scrollHeight;
}

function toggleMenu(){
  let m=document.getElementById("menu");
  m.style.display = m.style.display==="block"?"none":"block";
}

pantalla.addEventListener("input",()=>{
  let val = Number(pantalla.value);
  let bg = 255 - val * 2;
  document.body.style.background = `rgb(${bg},${bg},${bg})`;
  chat.style.background = `rgb(${Math.max(bg+20,20)},${Math.max(bg+20,20)},${Math.max(bg+20,20)})`;
  const header = document.querySelector(".header");
  header.style.background = val >= 50 ? "#ff8800" : "red";
});

function add(txt,type){
  let d=document.createElement("div");
  d.className="msg "+type;
  d.innerText=txt;
  chat.appendChild(d);
  chat.scrollTop=chat.scrollHeight;
  return d;
}

function hablar(txt){
  if(!voz.checked) return;
  let s=new SpeechSynthesisUtterance(txt);
  s.pitch=parseFloat(tono.value);
  s.lang = "es-ES";
  speechSynthesis.cancel();
  speechSynthesis.speak(s);
}

// ================= FOODSAVERIA PROMPTS =================

async function enviar() {
  if (esperando) return;
  verificarVencimiento();

  let inputEl = document.getElementById("input");
  let txt = inputEl.value.trim();
  if (!txt) return;

  add(txt, "user");
  inputEl.value = "";

  esperando = true;
  let elIA = add(perfil.esPremium ? "⭐ FoodSaverIA buscando receta Michelin completa..." : "🍳 FoodSaverIA generando ficha básica...", "ia");

  let promptInstruccion = "";

  if (perfil && perfil.esPremium) {
    promptInstruccion = "Actúa como FoodSaverIA en modo Recetario de Alta Cocina Michelin. Para el pedido '" + txt + "', genera la receta en español con este formato exacto:\n\n🍳 [NOMBRE DEL PLATO - FoodSaverIA Premium]\n⏱️ TIEMPO DE PREPARACIÓN Y PORCIONES:\n🛒 INGREDIENTES:\n- (Lista detallada)\n\n🔥 PREPARACIÓN PASO A PASO:\n1. (Pasos explicados)\n\n💡 SECRETO DEL CHEF:\n🧊 CONSERVACIÓN Y CONSEJO:";
  } else {
    promptInstruccion = "Actúa como FoodSaverIA en modo Gratuito y Limitado. Para '" + txt + "', da SOLO esta ficha súper corta en español:\n\n🍳 [NOMBRE DEL PLATO - FoodSaverIA Gratuito]\n🛒 INGREDIENTES PRINCIPALES (solo 3 o 4 ítems cortos).\n🔥 PREPARACIÓN RÁPIDA (máximo 2 pasos breves en un solo párrafo).\n\n(No incluyas tiempos, ni porciones, ni secretos de chef, ni tips de conservación. Al final agrega: '🔒 Suscribite a FoodSaverIA Premium para ver el paso a paso detallado y los secretos del chef').";
  }

  try {
    let url = "https://text.pollinations.ai/" + encodeURIComponent(promptInstruccion) + "?model=openai&seed=" + Math.floor(Math.random() * 1000);
    let res = await fetch(url);
    if(!res.ok) throw new Error("Error API");
    
    let respuestaText = await res.text();
    ultimaReceta = respuestaText.trim();

  } catch(err) {
    // LIMPIEZA INTELIGENTE DE TEXTO PARA RESPALDO
    let ingredienteLimpio = txt
      .replace(/quiero cocinar|como hacer|preparar|receta de|hacer|quiero/gi, "")
      .trim();

    if (!ingredienteLimpio) ingredienteLimpio = "tu receta";

    if(perfil.esPremium) {
      ultimaReceta = `🍳 FOODSAVERIA PREMIUM\n\n⏱️ TIEMPO: 25 min | PORCIONES: 2\n\n🛒 INGREDIENTES:\n- ${ingredienteLimpio}\n- Aceite, sal, pimienta y condimentos a gusto.\n\n🔥 PREPARACIÓN PASO A PASO:\n1. Cortá y dorá la base de ${ingredienteLimpio} en una sartén con un chorrito de aceite a fuego medio.\n2. Sazoná bien, agregá los demás componentes y cociná a fuego lento durante 15 minutos revolviendo despacio hasta que esté a punto.\n\n💡 SECRETO DEL CHEF: Cocinar a fuego lento y tapado preserva la humedad y potencia los sabores.\n🧊 CONSERVACIÓN: Guardar en recipiente hermético en heladera hasta por 48 horas.`;
    } else {
      ultimaReceta = `🍳 FOODSAVERIA GRATUITO\n\n🛒 INGREDIENTES PRINCIPALES:\n- ${ingredienteLimpio}\n- Aceite, sal y condimentos básicos.\n\n🔥 PREPARACIÓN RÁPIDA:\nCociná todos los ingredientes en una sartén o olla a fuego medio durante 15 minutos hasta dorar.\n\n🔒 Suscribite a FoodSaverIA Premium para ver el paso a paso detallado y los secretos del chef.`;
    }
  }

  if (perfil.esPremium) {
    escribirEfecto(elIA, ultimaReceta);
  } else {
    elIA.innerText = ultimaReceta;
    mostrarBotonGuardar();
    hablar(ultimaReceta);
    esperando = false;
  }
}
</script>

</body>
</html>

